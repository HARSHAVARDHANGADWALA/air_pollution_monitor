# Neo4j Database Connection Environment Variables
# Copy this file to .env and configure your database details

# For Local Neo4j Desktop:
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# For Cloud Neo4j AuraDB:
# NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=<your-password>
# NEO4J_DATABASE=neo4j
